{
  "name": "@amrita-constant/webui-plugin-kit",
  "version": "0.1.0",
  "description": "AmritaBot WebUI 插件构建套件：把宿主运行时依赖解析成 window.__AMRITA_HOST__ 的引用，避免插件打进第二份 React",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts",
    "./runtime": "./src/runtime.ts",
    "./host": "./src/host.ts",
    "./ui": "./src/ui.ts",
    "./ui-exports": "./src/ui-exports.ts"
  },
  "types": "./src/index.ts",
  "bin": {
    "amrita-plugin-build": "./bin/build-plugin.ts"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck"
  },
  "peerDependencies": {
    "@amrita-constant/ambot-ui": "^0.1.1",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^0.545.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@amrita-constant/ambot-ui": "^0.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "AmritaBot",
  "homepage": "https://github.com/AmritaBot/AmritaBot-PluginKit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmritaBot/AmritaBot-PluginKit.git"
  },
  "bugs": {
    "url": "https://github.com/AmritaBot/AmritaBot-PluginKit/issues"
  },
  "keywords": [
    "amrita",
    "amritabot",
    "plugin",
    "webui",
    "build",
    "bun"
  ]
}
